import { Theme } from "theme.slint";

component RadioRow inherits Rectangle {
    in property <string> label;
    in property <bool> checked: false;
    callback picked();

    min-height: 34px;
    vertical-stretch: 0;

    property <bool> pressed <=> ta.pressed;

    Rectangle {
        background: ta.has-hover ? Theme.key-hover : transparent;
        border-radius: Theme.radius;

        // 参考图：单选钮比头部图标更深一级缩进
        Rectangle {
            x: 40px;
            y: (parent.height - 20px) / 2;
            width: 20px;
            height: 20px;
            border-radius: 10px;
            border-width: root.checked ? 5.5px : 1.5px;
            border-color: root.checked ? Theme.accent : Theme.text-primary;

            Rectangle {
                visible: root.checked;
                x: 4px;
                y: 4px;
                width: 7px;
                height: 7px;
                border-radius: 4px;
                background: Theme.accent;
            }
        }
        Text {
            x: 72px;
            width: parent.width - 88px;
            text: root.label;
            color: Theme.text-primary;
            font-size: 13px;
            vertical-alignment: center;
        }
    }

    ta := TouchArea {
        clicked => { root.picked(); }
    }
}

/// 设置页：菜单底部"设置"进入，覆盖整个窗口
export component SettingsPage inherits Rectangle {
    in property <int> mode: 2;
    // 主题列表折叠状态（默认折叠，同 Win11 设置）
    private property <bool> theme-expanded: false;
    callback mode-picked(int);
    callback back();
    // 点击仓库地址：Rust 端用系统命令打开浏览器
    callback open-link(string);

    Rectangle {
        background: Theme.window;
    }

    // 返回按钮：钉在窗口左上角
    hdr-ta := TouchArea {
        x: 8px;
        y: 8px;
        width: 34px;
        height: 34px;
        clicked => { root.back(); }
    }
    Rectangle {
        x: hdr-ta.x;
        y: hdr-ta.y;
        width: hdr-ta.width;
        height: hdr-ta.height;
        background: hdr-ta.pressed ? Theme.key-pressed : (hdr-ta.has-hover ? Theme.key-hover : transparent);
        border-radius: Theme.radius;
    }
    Image {
        x: hdr-ta.x + (hdr-ta.width - 16px) / 2;
        y: hdr-ta.y + (hdr-ta.height - 16px) / 2;
        width: 16px;
        height: 16px;
        source: @image-url("icons/back.svg");
        colorize: Theme.text-primary;
    }

    // 「设置」标题：与返回按钮同一行，水平居中
    Text {
        x: 0;
        y: hdr-ta.y;
        width: root.width;
        height: hdr-ta.height;
        text: "设置";
        font-size: 16px;
        font-weight: 600;
        color: Theme.text-primary;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    VerticalLayout {
        padding: 12px;
        padding-top: 50px;
        spacing: 10px;

        Text {
            text: "外观";
            color: Theme.text-primary;
            font-size: 14px;
            font-weight: 600;
            min-height: 20px;
            vertical-alignment: center;
        }

        // 外观卡片：高度由内容驱动；头部行的 hover/点击区为绝对定位兄弟节点
        Rectangle {
            vertical-stretch: 0;

            // 卡片底色 + hover 高亮（hover 必须在底色之上、文字之下，故作为背景的子节点）
            Rectangle {
                background: Theme.card;
                border-radius: 8px;
                border-width: 1px;
                border-color: Theme.border;

                Rectangle {
                    x: 6px;
                    y: 6px;
                    width: parent.width - 12px;
                    height: 44px;
                    visible: exp-ta.has-hover;
                    background: Theme.key-hover;
                    border-radius: Theme.radius;
                }
            }
            VerticalLayout {
                padding: 6px;
                spacing: 4px;

                // 头部行：定高 44px，内部绝对定位，箭头钉右缘
                Rectangle {
                    min-height: 44px;
                    vertical-stretch: 0;

                    Image {
                        x: 12px;
                        y: (parent.height - 16px) / 2;
                        width: 16px;
                        height: 16px;
                        source: @image-url("icons/palette.svg");
                        colorize: Theme.text-primary;
                    }
                    Text {
                        x: 42px;
                        y: 6px;
                        width: parent.width - 80px;
                        text: "应用程序主题";
                        color: Theme.text-primary;
                        font-size: 13px;
                        horizontal-alignment: left;
                    }
                    Text {
                        x: 42px;
                        y: 24px;
                        width: parent.width - 80px;
                        text: "选择要显示的应用主题";
                        color: Theme.text-secondary;
                        font-size: 11px;
                        horizontal-alignment: left;
                    }
                    Image {
                        x: parent.width - 16px - 16px;
                        y: (parent.height - 12px) / 2;
                        width: 12px;
                        height: 12px;
                        // 折叠向下 / 展开向上：原用 🔽🔼 emoji（▾/▴ 在默认字体回退链无字形），
                        // 现改单色 SVG，两种渲染器都有形
                        source: root.theme-expanded ? @image-url("icons/chevron-up.svg") : @image-url("icons/chevron-down.svg");
                        colorize: Theme.text-secondary;
                    }
                }

                if root.theme-expanded: Rectangle { height: 1px; vertical-stretch: 0; background: Theme.border; }
                if root.theme-expanded: RadioRow { label: "浅色"; checked: root.mode == 0; picked => { root.mode-picked(0); } }
                if root.theme-expanded: RadioRow { label: "深色"; checked: root.mode == 1; picked => { root.mode-picked(1); } }
                if root.theme-expanded: RadioRow { label: "使用系统设置"; checked: root.mode == 2; picked => { root.mode-picked(2); } }
            }

            // 整行点击区（固定头部行几何：y:6 高 44，不引用 parent.height 避免布局环）
            exp-ta := TouchArea {
                x: 6px;
                y: 6px;
                width: parent.width - 12px;
                height: 44px;
                clicked => { root.theme-expanded = !root.theme-expanded; }
            }
        }

        Text {
            text: "关于";
            color: Theme.text-primary;
            font-size: 14px;
            font-weight: 600;
            min-height: 20px;
            vertical-alignment: center;
        }

        // 关于卡片：与外观卡片同一对齐基准 —— 图标 x:16、文字 x:48，全部左对齐
        Rectangle {
            vertical-stretch: 0;

            Rectangle {
                background: Theme.card;
                border-radius: 8px;
                border-width: 1px;
                border-color: Theme.border;
            }
            VerticalLayout {
                padding-top: 10px;
                padding-bottom: 10px;
                padding-left: 48px;
                padding-right: 16px;
                spacing: 3px;

                Text { text: "计算器"; color: Theme.text-primary; font-size: 13px; horizontal-alignment: left; }
                Text { text: "Slint + Rust 复刻 Microsoft Calculator"; color: Theme.text-secondary; font-size: 11px; horizontal-alignment: left; }
                Text {
                    text: "github.com/anlzou/slint-ms-calculator";
                    color: Theme.accent;
                    font-size: 11px;
                    horizontal-alignment: left;
                }
                Text { text: "作者 anlzou"; color: Theme.text-secondary; font-size: 11px; horizontal-alignment: left; }
                Text { text: "版本 0.1.0"; color: Theme.text-secondary; font-size: 11px; horizontal-alignment: left; }
            }
            Image {
                x: 18px;
                y: (parent.height - 16px) / 2;
                width: 16px;
                height: 16px;
                source: @image-url("icons/calculator.svg");
                colorize: Theme.text-secondary;
            }

            // 仓库地址点击区：覆盖第 3 行文字带
            link-ta := TouchArea {
                x: 48px;
                width: parent.width - 64px;
                y: parent.height - 60px;
                height: 16px;
                mouse-cursor: MouseCursor.pointer;
                clicked => { root.open-link("https://github.com/anlzou/slint-ms-calculator"); }
            }
        }

        Rectangle { vertical-stretch: 1; }
    }
}
