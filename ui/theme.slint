export global Theme {
    // Rust 端按 设置(浅色/深色/跟随系统) 写入，全部颜色由此派生
    in-out property <bool> dark: false;

    out property <color> window: dark ? #202020 : #f3f3f3;
    out property <color> card: dark ? #2b2b2b : #ffffff;
    out property <color> key-bg: dark ? #323232 : #fbfbfb;
    out property <color> key-bg-num: dark ? #3b3b3b : #fefefe;
    out property <color> key-hover: dark ? #414141 : #f0f0f0;
    out property <color> key-pressed: dark ? #2a2a2a : #dcdcdc;
    out property <color> accent: dark ? #4cc2ff : #0067c0;
    out property <color> accent-hover: dark ? #61caff : #1a7fd4;
    out property <color> accent-pressed: dark ? #3eb2ef : #005a9e;
    out property <color> accent-text: dark ? black : white;
    out property <color> text-primary: dark ? #f5f5f5 : #1a1a1a;
    out property <color> text-secondary: dark ? #a0a0a0 : #666666;
    out property <color> border: dark ? #454545 : #e0e0e0;
    out property <length> radius: 4px;
}
