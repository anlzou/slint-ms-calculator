import { Theme } from "theme.slint";

export component KeypadKey inherits Rectangle {
    in property <string> text;
    in property <string> code;
    in property <bool> accent: false;
    in property <bool> num: false;
    /// 锁定高亮（科学型 2nd 键），同按下底色
    in property <bool> active: false;
    callback clicked(string);

    min-height: 46px;
    vertical-stretch: 1;

    property <bool> pressed <=> ta.pressed;

    Rectangle {
        background: root.accent
            ? (root.pressed ? Theme.accent-pressed : (ta.has-hover ? Theme.accent-hover : Theme.accent))
            : ((root.pressed || root.active) ? Theme.key-pressed : (ta.has-hover ? Theme.key-hover : (root.num ? Theme.key-bg-num : Theme.key-bg)));
        border-radius: Theme.radius;
        border-width: 1px;
        border-color: root.accent ? Theme.accent : Theme.border;

        Text {
            text: root.text;
            color: root.accent ? Theme.accent-text : Theme.text-primary;
            font-size: 16px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    ta := TouchArea {
        clicked => { root.clicked(root.code); }
    }
}
