import { Theme } from "theme.slint";
// 必须从入口文件 re-export，Rust 端才会生成 global::<Theme>() 访问器
export { Theme } from "theme.slint";
import { DisplayArea } from "display.slint";
import { KeypadKey } from "keypad.slint";
import { MemoryBar } from "memory.slint";
import { HistoryPanel, HistoryItem, ModeMenu } from "history.slint";
import { SettingsPage } from "settings.slint";
import { ScientificKeypad } from "scientific.slint";

struct KeyDef {
    text: string,
    code: string,
    accent: bool,
    num: bool,
}

export component MainWindow inherits Window {
    title: "计算器";
    // 标题栏图标：🧮(U+1F9EE) 渲染成的单色 PNG（GDI+ 不支持彩色 emoji 分层）
    icon: @image-url("icon.png");
    background: Theme.window;
    // 置顶模式：隐藏标题栏（去掉三个窗口按钮）+ 恒在最前，窗口大小不变
    no-frame: root.pinned;
    always-on-top: root.pinned;
    // 无边框模式下窗口四缘留出拖拽带，可用边缘放大缩小（winit 后端）
    resize-border-width: root.pinned ? 8px : 0px;
    preferred-width: 380px;
    // 科学键盘多 1 行 + 分组下拉行，模式切换时窗口偏好高度随之变化
    preferred-height: root.sci-mode ? 620px : 580px;
    min-width: 320px;
    min-height: root.sci-mode ? 520px : 480px;

    in property <string> expression-text;
    in property <string> result-text: "0";
    in property <bool> memory-busy;
    in property <float> result-font: 34;
    in property <[HistoryItem]> history;
    // 科学型状态回显：Rust sync 按 App 写入
    in-out property <bool> sci-mode: false;
    in-out property <string> angle-label: "DEG";
    in-out property <bool> second-active: false;
    // 0=浅色 1=深色 2=跟随系统（Rust 读 get_theme_mode 计算 Theme.dark）
    in-out property <int> theme-mode: 2;
    callback key(string);
    callback history-recall(int);
    callback history-clear();
    callback theme-mode-changed(int);
    callback open-link(string);
    callback close-requested();
    // 仅用于通知 Rust 端重新施加 DWM 圆角偏好
    callback pin-toggled();

    // 保持在顶部：无边框 + 恒在最前（窗口尺寸不变），置顶模式带关闭按钮
    in-out property <bool> pinned: false;

    // ≡ 模式菜单浮层 / 时钟图标历史面板（回调内赋值用 =，属性名不带连字符以避开解析歧义）
    private property <bool> drawer: false;
    private property <bool> hist: false;
    private property <bool> settings-open: false;
    // 科学键盘分组浮层状态（0=收起 1=三角学 2=函数）：条件元素内的 id 外部不可达，提升到根
    private property <int> sci-menu: 0;

    // 置顶或菜单展开时收起 ≡/标准：图钉自动滑到最左上角
    private property <bool> chrome-hidden: root.pinned || root.drawer;

    private property <[KeyDef]> keys: [
        { text: "%", code: "percent", accent: false, num: false },
        { text: "CE", code: "ce", accent: false, num: false },
        { text: "C", code: "clear", accent: false, num: false },
        { text: "←", code: "backspace", accent: false, num: false },

        { text: "1/x", code: "inv", accent: false, num: false },
        { text: "x²", code: "square", accent: false, num: false },
        { text: "√x", code: "sqrt", accent: false, num: false },
        { text: "÷", code: "/", accent: false, num: false },

        { text: "7", code: "7", accent: false, num: true },
        { text: "8", code: "8", accent: false, num: true },
        { text: "9", code: "9", accent: false, num: true },
        { text: "×", code: "*", accent: false, num: false },

        { text: "4", code: "4", accent: false, num: true },
        { text: "5", code: "5", accent: false, num: true },
        { text: "6", code: "6", accent: false, num: true },
        { text: "-", code: "-", accent: false, num: false },

        { text: "1", code: "1", accent: false, num: true },
        { text: "2", code: "2", accent: false, num: true },
        { text: "3", code: "3", accent: false, num: true },
        { text: "+", code: "+", accent: false, num: false },

        { text: "±", code: "negate", accent: false, num: true },
        { text: "0", code: "0", accent: false, num: true },
        { text: ".", code: ".", accent: false, num: true },
        { text: "=", code: "=", accent: true, num: false },
    ];

    forward-focus: kb;

    // 键盘输入：物理按键文本直接透传给 Rust（数字/运算符/Enter/Esc/Backspace 等）
    kb := FocusScope {
        key-pressed(ev) => { root.key(ev.text); return accept; }

        VerticalLayout {
            padding: 6px;
            // 置顶模式：图钉贴左/上边缘 4px，与右上角关闭按钮到边框的距离一致
            padding-left: root.pinned ? 4px : 6px;
            padding-top: root.pinned ? 4px : 6px;
            spacing: 6px;

            // 顶栏：≡/标准/图钉 等宽单元格 + 等距；置顶或菜单展开时 ≡/标准 折叠，图钉滑到最左上角
            HorizontalLayout {
                min-height: 28px;
                spacing: root.chrome-hidden ? 0px : 4px;

                Rectangle {
                    visible: !root.chrome-hidden;
                    min-width: root.chrome-hidden ? 0px : 26px;
                    max-width: root.chrome-hidden ? 0px : 26px;
                    min-height: root.chrome-hidden ? 0px : 26px;
                    menu-ta := TouchArea {
                        clicked => { root.drawer = !root.drawer; }
                    }
                    Rectangle {
                        background: menu-ta.pressed ? Theme.key-pressed : (menu-ta.has-hover ? Theme.key-hover : transparent);
                        border-radius: Theme.radius;
                    }
                    Text {
                        text: "三";
                        color: Theme.text-primary;
                        font-size: 13px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                // 「标准/科学」：Slint 布局中 visible:false 仍占位，须用 min/max-width 归零折叠
                Text {
                    visible: !root.chrome-hidden;
                    min-width: root.chrome-hidden ? 0px : 30px;
                    max-width: root.chrome-hidden ? 0px : 30px;
                    text: root.sci-mode ? "科学" : "标准";
                    color: Theme.text-primary;
                    font-size: 13px;
                    font-weight: 600;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                // 保持在顶部：切换全屏置顶，高度同 ≡，宽度收紧；图标用 ui/icons/pin.svg
                Rectangle {
                    min-width: 26px;
                    max-width: 26px;
                    min-height: 26px;
                    pin-ta := TouchArea {
                        clicked => {
                            root.pinned = !root.pinned;
                            root.pin-toggled();
                        }
                    }
                    // 单色 SVG 图标可被 colorize 染色，置顶态直接用强调色（emoji 做不到）
                    Rectangle {
                        background: root.pinned || pin-ta.pressed ? Theme.key-pressed : (pin-ta.has-hover ? Theme.key-hover : transparent);
                        border-radius: Theme.radius;
                    }
                    Image {
                        x: (parent.width - 14px) / 2;
                        y: (parent.height - 14px) / 2;
                        width: 14px;
                        height: 14px;
                        source: @image-url("icons/pin.svg");
                        colorize: root.pinned ? Theme.accent : Theme.text-primary;
                    }
                }

                // 顶栏空白区：置顶模式下可按住拖动窗口（普通点击不移动，按钮不受影响）
                WindowMoveArea {
                    enabled: root.pinned;
                    horizontal-stretch: 1;
                }
            }

            // 显示区：科学浮层打开时点这里也收起浮层（浮层不覆盖此区域，遮罩不会挡住浮层点击）
            Rectangle {
                vertical-stretch: 1;
                min-height: 96px;
                DisplayArea {
                    expression-text: root.expression-text;
                    result-text: root.result-text;
                    result-font: root.result-font;
                }
                // DEG/RAD 芯片：同原版放在显示屏左上角（声明在收起遮罩前，浮层打开时点击先收起）
                if root.sci-mode: Rectangle {
                    x: 6px;
                    y: 4px;
                    width: 46px;
                    height: 24px;
                    border-radius: Theme.radius;
                    border-width: 1px;
                    border-color: Theme.border;
                    background: deg-ta.has-hover ? Theme.key-hover : Theme.card;
                    deg-ta := TouchArea {
                        clicked => { root.key(root.angle-label == "DEG" ? "rad" : "deg"); }
                    }
                    Text {
                        text: root.angle-label;
                        color: Theme.text-primary;
                        font-size: 12px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
                if root.sci-mode && root.sci-menu != 0: TouchArea {
                    clicked => { root.sci-menu = 0; }
                }
            }

            MemoryBar {
                busy: root.memory-busy;
                vertical-stretch: 0;
                act(code) => { root.key(code); }
            }

            // 历史打开时面板占据键盘区域（同原版）
            if root.hist: HistoryPanel {
                items: root.history;
                recall(i) => { root.history-recall(i); }
                cleared => { root.history-clear(); }
            }
            if !root.hist && !root.sci-mode: GridLayout {
                spacing: 4px;
                for k[index] in root.keys: KeypadKey {
                    row: index / 4;
                    col: Math.mod(index, 4);
                    text: k.text;
                    code: k.code;
                    accent: k.accent;
                    num: k.num;
                    clicked(code) => { root.key(code); }
                }
            }
            if !root.hist && root.sci-mode: ScientificKeypad {
                menu-open <=> root.sci-menu;
                angle-label: root.angle-label;
                second-active: root.second-active;
                key-pressed(code) => { root.key(code); }
            }
        }
    }

    // 时钟图标：绝对定位钉在窗口右上角，打开/关闭历史面板（声明在遮罩之前，菜单打开时会被盖住）
    Rectangle {
        visible: !root.pinned;
        x: root.width - 40px;
        y: 4px;
        width: 36px;
        height: 28px;
        hist-ta := TouchArea {
            clicked => { root.hist = !root.hist; }
        }
        Rectangle {
            background: hist-ta.pressed ? Theme.key-pressed : (hist-ta.has-hover ? Theme.key-hover : transparent);
            border-radius: Theme.radius;
        }
        Image {
            x: (parent.width - 16px) / 2;
            y: (parent.height - 16px) / 2;
            width: 16px;
            height: 16px;
            source: @image-url("icons/history.svg");
            colorize: Theme.text-primary;
        }
    }

    // 置顶模式的关闭按钮：右上角（无边框后替代系统 X）
    Rectangle {
        visible: root.pinned;
        x: root.width - 40px;
        y: 4px;
        width: 36px;
        height: 28px;
        close-ta := TouchArea {
            clicked => { root.close-requested(); }
        }
        Rectangle {
            background: close-ta.pressed ? #b3271a : (close-ta.has-hover ? #c42b1c : transparent);
            border-radius: Theme.radius;
        }
        // 关闭叉：单色 SVG，hover/按下时底色变红、图标转白
        Image {
            x: (parent.width - 13px) / 2;
            y: (parent.height - 13px) / 2;
            width: 13px;
            height: 13px;
            source: @image-url("icons/close.svg");
            colorize: close-ta.has-hover || close-ta.pressed ? white : Theme.text-primary;
        }
    }

    // ≡ 菜单：半透明遮罩 + 左侧浮层，点遮罩收起
    Rectangle {
        visible: root.drawer;
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        background: rgba(0, 0, 0, 0.28);

        TouchArea {
            clicked => { root.drawer = false; }
        }
    }

    ModeMenu {
        visible: root.drawer;
        x: 0px;
        y: 0px;
        width: 240px;
        height: root.height;
        current-mode: root.sci-mode ? 1 : 0;
        picked(idx) => {
            root.drawer = false;
            // 0=标准 1=科学，-1 为未实现模式（仅收起）
            if idx >= 0 {
                root.key(idx == 1 ? "scientific" : "standard");
            }
        }
        settings => { root.drawer = false; root.settings-open = true; }
    }

    // 设置页：覆盖整个窗口
    if root.settings-open: SettingsPage {
        mode: root.theme-mode;
        mode-picked(m) => { root.theme-mode = m; root.theme-mode-changed(m); }
        back => { root.settings-open = false; }
        open-link(url) => { root.open-link(url); }
    }
}
