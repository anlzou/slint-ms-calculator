import { Theme } from "theme.slint";

export struct HistoryItem {
    expression: string,
    result: string,
}

component HistoryCell inherits Rectangle {
    in property <HistoryItem> item;
    in property <int> index;
    callback clicked(int);

    min-height: 48px;

    property <bool> pressed <=> ta.pressed;

    Rectangle {
        background: root.pressed ? Theme.key-pressed : (ta.has-hover ? Theme.key-hover : transparent);
        border-radius: Theme.radius;

        Text {
            x: 6px;
            y: 5px;
            width: parent.width - 12px;
            text: root.item.expression;
            color: Theme.text-secondary;
            font-size: 11px;
            horizontal-alignment: right;
            overflow: elide;
        }
        Text {
            x: 6px;
            y: 22px;
            width: parent.width - 12px;
            text: root.item.result;
            color: Theme.text-primary;
            font-size: 16px;
            horizontal-alignment: right;
            overflow: elide;
        }
    }

    ta := TouchArea {
        clicked => { root.clicked(root.index); }
    }
}

/// 历史面板：打开时占据键盘区域，底部右侧垃圾桶清除
export component HistoryPanel inherits Rectangle {
    in property <[HistoryItem]> items;
    callback recall(int);
    callback cleared();

    // 顶部分隔线（Rectangle 不支持单边 border，用细条补）
    Rectangle {
        y: 0px;
        height: 1px;
        width: root.width;
        background: Theme.border;
    }

    VerticalLayout {
        padding: 4px;
        // 底部留白，避免最后一条记录被右下角清除按钮遮挡
        padding-bottom: 30px;
        spacing: 2px;

        if root.items.length == 0: Text {
            text: "无历史记录";
            color: Theme.text-secondary;
            font-size: 13px;
            horizontal-alignment: center;
            vertical-alignment: center;
            vertical-stretch: 1;
        }
        if root.items.length > 0: Flickable {
            vertical-stretch: 1;
            // 单元格固定 48px 高
            content-height: root.items.length * 48px + 4px;

            VerticalLayout {
                spacing: 2px;
                for h[index] in root.items: HistoryCell {
                    item: h;
                    index: index;
                    clicked(i) => { root.recall(i); }
                }
            }
        }
    }

    // 清除按钮：绝对定位钉在面板右下角（浮在列表之上）
    Rectangle {
        x: root.width - 42px;
        y: root.height - 32px;
        width: 36px;
        height: 28px;
        clear-ta := TouchArea {
            clicked => { root.cleared(); }
        }
        Rectangle {
            background: clear-ta.pressed ? Theme.key-pressed : (clear-ta.has-hover ? Theme.key-hover : transparent);
            border-radius: Theme.radius;
        }
        // 清空历史：垃圾桶图标（图标列与 MenuItem 一样固定 26px 宽）
        Rectangle {
            x: 8px;
            width: 26px;
            y: (parent.height - 16px) / 2;
            height: 16px;
            Image {
                x: (parent.width - 16px) / 2;
                source: @image-url("icons/trash.svg");
                width: 16px;
                height: 16px;
                colorize: Theme.text-primary;
            }
        }
    }
}

component MenuItem inherits Rectangle {
    in property <string> label;
    // 图标一律用 ui/icons/ 下的单色 SVG（Tabler），靠 colorize 跟随主题换色。
    // 不用 emoji：软件渲染器没有彩色 emoji 字体可回退，整块会渲染成空白。
    in property <image> icon;
    in property <bool> selected: false;
    in property <bool> available: false;
    callback picked();

    min-height: 34px;

    property <bool> pressed <=> ta.pressed;

    Rectangle {
        background: root.selected ? Theme.key-hover : (root.pressed ? Theme.key-pressed : (ta.has-hover ? Theme.key-hover : transparent));
        border-radius: Theme.radius;

        Rectangle {
            visible: root.selected;
            x: 2px;
            y: (parent.height - 16px) / 2;
            width: 3px;
            height: 16px;
            background: Theme.accent;
            border-radius: 2px;
        }
        // 图标列：固定 26px 宽居中，文字统一从 x:44 起，保证与原版对齐节奏
        // Image 按尺寸拉伸（image-fit 默认 fill），所以外面套一个定宽盒、图标本身取正方形
        Rectangle {
            x: 8px;
            width: 26px;
            y: (parent.height - 16px) / 2;
            height: 16px;
            Image {
                x: (parent.width - 16px) / 2;
                source: root.icon;
                width: 16px;
                height: 16px;
                colorize: root.available ? Theme.text-primary : Theme.text-secondary;
            }
        }
        Text {
            x: 44px;
            width: parent.width - 48px;
            text: root.label;
            color: root.available ? Theme.text-primary : Theme.text-secondary;
            font-size: 13px;
            vertical-alignment: center;
        }
    }

    ta := TouchArea {
        clicked => { root.picked(); }
    }
}

/// ≡ 打开的模式菜单（标准/科学可用，其余模式置灰占位），可滚动
export component ModeMenu inherits Rectangle {
    /// 0=标准 1=科学，驱动选中竖条
    in property <int> current-mode: 0;
    /// 0=标准 1=科学，其余项 -1（仅收起）
    callback picked(int);
    callback settings();

    // 面板描边 + 圆角：左侧贴边取直角，仅右上/右下带弧度（同 Win11 浮出面板）
    Rectangle {
        background: Theme.card;
        border-top-left-radius: 0px;
        border-bottom-left-radius: 0px;
        border-top-right-radius: 8px;
        border-bottom-right-radius: 8px;
        border-width: 1px;
        border-color: Theme.border;
    }

    VerticalLayout {
        padding: 0;
        spacing: 0;

        Flickable {
            vertical-stretch: 1;
            // 2 个分组标题 + 18 个菜单项 + 内边距的估算内容高
            content-height: 724px;

            VerticalLayout {
                padding: 8px;
                spacing: 2px;

                // 分组标题：计算器
                Rectangle {
                    min-height: 24px;
                    Text {
                        x: 8px;
                        width: parent.width - 12px;
                        text: "计算器";
                        color: Theme.text-secondary;
                        font-size: 12px;
                        horizontal-alignment: left;
                        vertical-alignment: center;
                    }
                }
                MenuItem { label: "标准"; icon: @image-url("icons/calculator.svg"); selected: root.current-mode == 0; available: true; picked => { root.picked(0); } } // 算盘/计算器
                MenuItem { label: "科学"; icon: @image-url("icons/flask.svg"); selected: root.current-mode == 1; available: true; picked => { root.picked(1); } } // 试管/实验瓶
                MenuItem { label: "绘图"; icon: @image-url("icons/chart-line.svg"); picked => { root.picked(-1); } } // 上升趋势图
                MenuItem { label: "程序员"; icon: @image-url("icons/laptop.svg"); picked => { root.picked(-1); } } // 笔记本电脑
                MenuItem { label: "日期计算"; icon: @image-url("icons/calendar.svg"); picked => { root.picked(-1); } } // 日历

                // 分组标题：转换器
                Rectangle {
                    min-height: 24px;
                    Text {
                        x: 8px;
                        width: parent.width - 12px;
                        text: "转换器";
                        color: Theme.text-secondary;
                        font-size: 12px;
                        horizontal-alignment: left;
                        vertical-alignment: center;
                    }
                }
                MenuItem { label: "货币"; icon: @image-url("icons/exchange.svg"); picked => { root.picked(-1); } } // 货币兑换
                MenuItem { label: "体积"; icon: @image-url("icons/box.svg"); picked => { root.picked(-1); } } // 包裹/箱子
                MenuItem { label: "长度"; icon: @image-url("icons/ruler.svg"); picked => { root.picked(-1); } } // 直尺
                MenuItem { label: "重量"; icon: @image-url("icons/dumbbell.svg"); picked => { root.picked(-1); } } // 举重/哑铃
                MenuItem { label: "温度"; icon: @image-url("icons/thermometer.svg"); picked => { root.picked(-1); } } // 温度计
                MenuItem { label: "能量"; icon: @image-url("icons/flame.svg"); picked => { root.picked(-1); } } // 火焰 (原图能量图标是火焰)
                MenuItem { label: "面积"; icon: @image-url("icons/map.svg"); picked => { root.picked(-1); } } // 地图
                MenuItem { label: "速度"; icon: @image-url("icons/run.svg"); picked => { root.picked(-1); } } // 跑步
                MenuItem { label: "时间"; icon: @image-url("icons/stopwatch.svg"); picked => { root.picked(-1); } } // 秒表/时钟
                MenuItem { label: "功率"; icon: @image-url("icons/bolt.svg"); picked => { root.picked(-1); } } // 闪电
                MenuItem { label: "数据"; icon: @image-url("icons/floppy.svg"); picked => { root.picked(-1); } } // 软盘/数据
                MenuItem { label: "压强"; icon: @image-url("icons/gauge.svg"); picked => { root.picked(-1); } } // 计时器/仪表盘
                MenuItem { label: "角度"; icon: @image-url("icons/angle.svg"); picked => { root.picked(-1); } } // 三角尺/量角器
            }
        }

        Rectangle { height: 1px; background: Theme.border; }
        // 与上方列表同一内边距（8px），使「设置」图标/文字与功能列对齐
        VerticalLayout {
            padding: 8px;
            MenuItem { label: "设置"; icon: @image-url("icons/settings.svg"); available: true; picked => { root.settings(); } }
        }
    }
}
