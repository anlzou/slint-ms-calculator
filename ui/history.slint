import { Theme } from "theme.slint";

export struct HistoryItem {
    expression: string,
    result: string,
}

component HistoryCell inherits Rectangle {
    in property <HistoryItem> item;
    in property <int> index;
    callback clicked(int);

    min-height: 48px;

    property <bool> pressed <=> ta.pressed;

    Rectangle {
        background: root.pressed ? Theme.key-pressed : (ta.has-hover ? Theme.key-hover : transparent);
        border-radius: Theme.radius;

        Text {
            x: 6px;
            y: 5px;
            width: parent.width - 12px;
            text: root.item.expression;
            color: Theme.text-secondary;
            font-size: 11px;
            horizontal-alignment: right;
            overflow: elide;
        }
        Text {
            x: 6px;
            y: 22px;
            width: parent.width - 12px;
            text: root.item.result;
            color: Theme.text-primary;
            font-size: 16px;
            horizontal-alignment: right;
            overflow: elide;
        }
    }

    ta := TouchArea {
        clicked => { root.clicked(root.index); }
    }
}

/// 历史面板：打开时占据键盘区域，底部右侧垃圾桶清除
export component HistoryPanel inherits Rectangle {
    in property <[HistoryItem]> items;
    callback recall(int);
    callback cleared();

    // 顶部分隔线（Rectangle 不支持单边 border，用细条补）
    Rectangle {
        y: 0px;
        height: 1px;
        width: root.width;
        background: Theme.border;
    }

    VerticalLayout {
        padding: 4px;
        // 底部留白，避免最后一条记录被右下角清除按钮遮挡
        padding-bottom: 30px;
        spacing: 2px;

        if root.items.length == 0: Text {
            text: "无历史记录";
            color: Theme.text-secondary;
            font-size: 13px;
            horizontal-alignment: center;
            vertical-alignment: center;
            vertical-stretch: 1;
        }
        if root.items.length > 0: Flickable {
            vertical-stretch: 1;
            // 单元格固定 48px 高
            content-height: root.items.length * 48px + 4px;

            VerticalLayout {
                spacing: 2px;
                for h[index] in root.items: HistoryCell {
                    item: h;
                    index: index;
                    clicked(i) => { root.recall(i); }
                }
            }
        }
    }

    // 清除按钮：绝对定位钉在面板右下角（浮在列表之上）
    Rectangle {
        x: root.width - 42px;
        y: root.height - 32px;
        width: 36px;
        height: 28px;
        TouchArea {
            clicked => { root.cleared(); }
        }
        // 手绘垃圾桶：把手 / 盖 / 桶身
        Rectangle { x: parent.width / 2 - 4px; y: parent.height / 2 - 8px; width: 8px; height: 1.5px; background: Theme.text-primary; }
        Rectangle { x: parent.width / 2 - 9px; y: parent.height / 2 - 6px; width: 18px; height: 1.5px; background: Theme.text-primary; }
        Rectangle { x: parent.width / 2 - 7px; y: parent.height / 2 - 3px; width: 14px; height: 11px; border-width: 1.5px; border-color: Theme.text-primary; border-radius: 2px; }
    }
}

component MenuItem inherits Rectangle {
    in property <string> label;
    in property <string> glyph: "";
    in property <string> glyph-font: "Segoe MDL2 Assets";
    in property <bool> selected: false;
    in property <bool> available: false;
    callback picked();

    min-height: 34px;

    property <bool> pressed <=> ta.pressed;

    Rectangle {
        background: root.selected ? Theme.key-hover : (root.pressed ? Theme.key-pressed : (ta.has-hover ? Theme.key-hover : transparent));
        border-radius: Theme.radius;

        Rectangle {
            visible: root.selected;
            x: 2px;
            y: (parent.height - 16px) / 2;
            width: 3px;
            height: 16px;
            background: Theme.accent;
            border-radius: 2px;
        }
        // 图标列：固定 26px 宽居中，文字统一从 x:44 起，保证与原版对齐节奏
        Text {
            x: 8px;
            width: 26px;
            text: root.glyph;
            font-family: root.glyph-font;
            font-size: 14px;
            color: root.available ? Theme.text-primary : Theme.text-secondary;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        Text {
            x: 44px;
            width: parent.width - 48px;
            text: root.label;
            color: root.available ? Theme.text-primary : Theme.text-secondary;
            font-size: 13px;
            vertical-alignment: center;
        }
    }

    ta := TouchArea {
        clicked => { root.picked(); }
    }
}

/// ≡ 打开的模式菜单（v1 仅"标准"可用，其余模式置灰占位），可滚动
export component ModeMenu inherits Rectangle {
    callback picked();
    callback settings();

    Rectangle {
        background: Theme.card;
    }
    // 右缘描边（Rectangle 不支持单边 border，用细条补）
    Rectangle {
        x: root.width - 1px;
        width: 1px;
        height: root.height;
        background: Theme.border;
    }

    VerticalLayout {
        padding: 0;
        spacing: 0;

        Flickable {
            vertical-stretch: 1;
            // 2 个分组标题 + 18 个菜单项 + 内边距的估算内容高
            content-height: 724px;

            VerticalLayout {
                padding: 8px;
                spacing: 2px;

                // 分组标题：Text 无 padding，用 Rectangle 包裹实现 44px 左缩进
                Rectangle {
                    min-height: 24px;
                    Text {
                        x: 44px;
                        width: parent.width - 44px;
                        text: "计算器";
                        color: Theme.text-secondary;
                        font-size: 12px;
                        vertical-alignment: center;
                    }
                }
                MenuItem { label: "标准"; glyph: "\u{e8ef}"; selected: true; available: true; picked => { root.picked(); } }
                MenuItem { label: "科学"; glyph: "ƒ"; glyph-font: ""; picked => { root.picked(); } }
                MenuItem { label: "绘图"; glyph: "•"; glyph-font: ""; picked => { root.picked(); } }
                MenuItem { label: "程序员"; glyph: "\u{e765}"; picked => { root.picked(); } }
                MenuItem { label: "日期计算"; glyph: "\u{e787}"; picked => { root.picked(); } }

                Rectangle {
                    min-height: 24px;
                    Text {
                        x: 44px;
                        width: parent.width - 44px;
                        text: "转换器";
                        color: Theme.text-secondary;
                        font-size: 12px;
                        vertical-alignment: center;
                    }
                }
                MenuItem { label: "货币"; glyph: "¥"; glyph-font: ""; picked => { root.picked(); } }
                MenuItem { label: "体积"; glyph: "•"; glyph-font: ""; picked => { root.picked(); } }
                MenuItem { label: "长度"; glyph: "•"; glyph-font: ""; picked => { root.picked(); } }
                MenuItem { label: "重量"; glyph: "•"; glyph-font: ""; picked => { root.picked(); } }
                MenuItem { label: "温度"; glyph: "℃"; glyph-font: ""; picked => { root.picked(); } }
                MenuItem { label: "能量"; glyph: "•"; glyph-font: ""; picked => { root.picked(); } }
                MenuItem { label: "面积"; glyph: "•"; glyph-font: ""; picked => { root.picked(); } }
                MenuItem { label: "速度"; glyph: "•"; glyph-font: ""; picked => { root.picked(); } }
                MenuItem { label: "时间"; glyph: "•"; glyph-font: ""; picked => { root.picked(); } }
                MenuItem { label: "功率"; glyph: "•"; glyph-font: ""; picked => { root.picked(); } }
                MenuItem { label: "数据"; glyph: "•"; glyph-font: ""; picked => { root.picked(); } }
                MenuItem { label: "压强"; glyph: "•"; glyph-font: ""; picked => { root.picked(); } }
                MenuItem { label: "角度"; glyph: "∠"; glyph-font: ""; picked => { root.picked(); } }
            }
        }

        Rectangle { height: 1px; background: Theme.border; }
        MenuItem { label: "设置"; glyph: "\u{e713}"; available: true; picked => { root.settings(); } }
    }
}
